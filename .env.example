VOICE_INPUT_ENV=development
VOICE_INPUT_BEARER_TOKEN=replace-me
VOICE_INPUT_BACKEND=mock
VOICE_INPUT_MOCK_TRANSCRIPT=语音输入法连接成功。
VOICE_INPUT_MAX_AUDIO_BYTES=67108864
VOICE_INPUT_MAX_SESSION_SECONDS=180
VOICE_INPUT_MAX_CONCURRENT_SESSIONS=4
VOICE_INPUT_SHUTDOWN_GRACE_SECONDS=20
VOICE_INPUT_BACKEND_CLOSE_TIMEOUT_SECONDS=5

# When VOICE_INPUT_BACKEND=openai-http:
VOICE_INPUT_OPENAI_URL=http://127.0.0.1:8000/v1/audio/transcriptions
VOICE_INPUT_OPENAI_TOKEN=
VOICE_INPUT_OPENAI_MODEL=whisper-1
VOICE_INPUT_OPENAI_TIMEOUT_SECONDS=90

# When proxying the currently deployed VoiceInk streaming WebSocket:
VOICE_INPUT_VOICEINK_URL=ws://127.0.0.1:8765/api/voice-input/stream
VOICE_INPUT_VOICEINK_TOKEN=
VOICE_INPUT_VOICEINK_TIMEOUT_SECONDS=30

# Optional OpenAI-compatible /chat/completions endpoint for smart/command modes:
# Example: http://127.0.0.1:8001/v1/chat/completions
VOICE_INPUT_ORGANIZER_URL=
VOICE_INPUT_ORGANIZER_TLS_SERVER_NAME=
VOICE_INPUT_ORGANIZER_TOKEN=
VOICE_INPUT_ORGANIZER_MODEL=
VOICE_INPUT_ORGANIZER_TIMEOUT_SECONDS=30
